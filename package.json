{
  "name": "vite-app-version",
  "version": "1.0.0",
  "description": "Vite plugin + runtime client for SPA version detection via buildTime, with configurable watch triggers and onUpdate callback",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./dist/client.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts"
    }
  },
  "files": [
    "dist",
    "src/client",
    "src/shared",
    "src/constants.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('src/virtual.d.ts', 'dist/virtual.d.ts')\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "version",
    "version-check",
    "build-time",
    "spa",
    "hot-update",
    "auto-reload",
    "deploy"
  ],
  "author": "Qin Sunrise",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/960602906/vite-app-version.git"
  },
  "homepage": "https://github.com/960602906/vite-app-version#readme",
  "bugs": {
    "url": "https://github.com/960602906/vite-app-version/issues"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.9"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}